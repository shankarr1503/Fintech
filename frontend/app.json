{
  "expo": {
    "name": "CoinQuest",
    "slug": "coinquest",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "coinquest",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.coinquest"
    },
    "android": {
      "package": "app.coinquest",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#06080F"
      },
      "edgeToEdgeEnabled": true,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_CONTACTS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "CoinQuest",
      "themeColor": "#06080F",
      "lang": "en-IN",
      "description": "Pay with UPI, track spending and bills, plan your way out of debt and build savings goals, with rewards for good money habits."
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#06080F"
        }
      ],
      "expo-font",
      [
        "expo-sensors",
        {
          "motionPermission": "CoinQuest uses motion only to tilt cards slightly as you move your phone. Nothing is recorded."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "CoinQuest uses the camera only to scan UPI payment QR codes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock CoinQuest instead of typing your PIN. Your face data never leaves your phone."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8CF0D2"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
