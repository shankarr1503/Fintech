# Leave empty to use an in-memory database (data resets on restart)
MONGO_URL=mongodb://localhost:27017
DB_NAME=coinquest

# Optional - enables AI insights & auto-categorisation (falls back to rules when unset)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# true = OTP is returned in the API response instead of being sent by SMS, and sample data is seeded.
# Defaults to false when unset; with false the server refuses to start without the security settings below.
DEMO_MODE=true

# Comma-separated list, or * for any origin
CORS_ORIGINS=*

# Security (required when DEMO_MODE=false)
# Signs session tokens: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# AES-256 key for identity fields: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=
WEBHOOK_SECRET=
ADMIN_API_KEY=
REQUIRE_HTTPS=false
IDLE_TIMEOUT_MINUTES=15
PUSH_ENABLED=false
